{
  "manifest_version": 3,
  "name": "AutoFill Admin",
  "short_name": "AutoFill Admin",
  "version": "1.0.0",
  "description": "Pré-remplit vos formulaires administratifs à partir de vos documents. Usage personnel ; vous vérifiez et validez vous-même.",
  "minimum_chrome_version": "121",
  "permissions": ["storage", "scripting", "clipboardRead"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "AutoFill Admin",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+A" },
      "description": "Ouvrir AutoFill Admin"
    },
    "remplir-cible": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "Remplir le formulaire de l'onglet cible"
    }
  }
}
